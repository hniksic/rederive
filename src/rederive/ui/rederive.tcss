/* Layout and colors for the four bands of an Algebra pane.
   Every color here comes from rederive.ui.theme via $rd-* variables, named
   after the slots Derive's own Options Color commands expose. */

Screen {
    background: $rd-menu-background;
    color: $rd-work-foreground;
    layout: vertical;
}

/* Everything above the rule: one work area per window, placed by hand over a
   frame that draws what is between them. The frame is a layer of its own and
   underneath, so a work area covers only its own window's interior and the
   borders show through around it. */
#panes {
    height: 1fr;
    layers: frame panes;
    background: $rd-work-background;
}

#frame {
    layer: frame;
    position: absolute;
    offset: 0 0;
    width: 100%;
    height: 100%;
    color: $rd-frame;
}

/* The history grows upwards from the bottom of its window: with a few entries
   the work area is empty at the top, and the newest entry always sits against
   the bottom. Where each one is and how big it is are set as the windows are
   placed, which is why no size is given here. */
.work {
    layer: panes;
    position: absolute;
    align-vertical: bottom;
    background: $rd-work-background;
    color: $rd-work-foreground;
    /* A render never wraps, so one too wide for the pane is clipped at the
       edge. Ctrl-Right scrolls to the rest of it by shifting the selected
       entry alone, which is a repaint rather than a scroll of the pane. */
    overflow-x: hidden;
    scrollbar-size: 0 0;
}

.work-content {
    height: auto;
    width: auto;
}

#rule {
    height: 1;
    color: $rd-frame;
}

#menu {
    height: 2;
    color: $rd-option;
}

/* Options dialogs stand where the menu does, and are colored like it. */
#fields {
    height: 2;
    color: $rd-option;
}

/* The list of names a file prompt opens. It sits between the work area and
   the line being typed, and takes its rows from the work area rather than
   floating over it: the expressions it covers are the oldest on screen, and
   nothing has to be drawn in two layers. The height is set as the list is
   filled, which is why none is given here. */
#completions {
    border: round $rd-frame;
    border-title-color: $rd-option;
    background: $rd-work-background;
    color: $rd-work-foreground;
    padding: 0;
    overflow: hidden;
}

#prompt-band {
    height: 2;
}

/* The prompt label takes the Option color, not the Prompt color: in the
   original it is yellow like the menu, while the message line below it is
   red. */
#prompt-label {
    width: auto;
    color: $rd-option;
}

#prompt-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $rd-work-background;
    background-tint: $rd-work-background;
    color: $rd-work-foreground;
}

#prompt-input > .input--cursor {
    background: $rd-selection-background;
    color: $rd-work-background;
}

#message {
    height: 1;
    color: $rd-prompt;
}

#status {
    height: 1;
}
