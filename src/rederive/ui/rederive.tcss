/* Layout and colors for the four bands of an Algebra pane.
   Every color here comes from rederive.ui.theme via $rd-* variables, named
   after the slots Derive's own Options Color commands expose. */

Screen {
    background: $rd-menu-background;
    color: $rd-work-foreground;
    layout: vertical;
}

/* The history grows upwards from the rule: with a few entries the work area
   is empty at the top, and the newest entry always sits against the bottom. */
#work {
    height: 1fr;
    align-vertical: bottom;
    background: $rd-work-background;
    color: $rd-work-foreground;
    scrollbar-size: 0 0;
}

#work-content {
    height: auto;
}

#rule {
    height: 1;
    color: $rd-frame;
}

#menu {
    height: 2;
    color: $rd-option;
}

/* Options dialogs stand where the menu does, and are colored like it. */
#fields {
    height: 2;
    color: $rd-option;
}

#author-band {
    height: 2;
}

/* The author prompt takes the Option color, not the Prompt color: in Derive it
   is yellow like the menu, while the message line below it is red. */
#author-prompt {
    width: auto;
    color: $rd-option;
}

#author-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $rd-work-background;
    background-tint: $rd-work-background;
    color: $rd-work-foreground;
}

#author-input > .input--cursor {
    background: $rd-selection-background;
    color: $rd-work-background;
}

#message {
    height: 1;
    color: $rd-prompt;
}

#status {
    height: 1;
}
